{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node", "spotify-web-api-node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/routeTree.gen.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", ".output", ".vercel"]
}
